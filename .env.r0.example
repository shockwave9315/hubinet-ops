# Hubinet Ops 0.5 R0 runtime secrets (example).
#
# Copy to /etc/hubinet-ops/agent.env on the target host (mode 0600, owned
# by the hubinetops service user) and fill in real values. Never commit a
# populated copy of this file -- scripts/check_tracked_files.py enforces
# this in CI.
#
# These two secrets are independent and must never be confused with each
# other: the PVE token authenticates Hubinet Ops -> Proxmox (outbound);
# the R0 API token authenticates Home Assistant -> Hubinet Ops (inbound).

# Proxmox VE API token, in the exact PVE API-token shape:
#   user@realm!tokenid=secret
# e.g. root@pam!hubinet-ops=00000000-0000-0000-0000-000000000000
HUBINET_OPS_R0_PVE_TOKEN=

# R0 HTTP API bearer token. Operator-generated; recommended
# minimum 32 bytes of entropy, e.g.:
#   openssl rand -hex 32
HUBINET_OPS_R0_API_TOKEN=
