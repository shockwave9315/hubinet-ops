  {
    "vector_id": "jsonl_line_at_max_bytes_boundary",
    "parser_family": "jsonl_line",
    "primitive_function": "decode_jsonl_line",
    "frozen_equivalent": "_load_jsonl",
    "input": {
      "kind": "padded_object_line",
      "total_bytes": 1048576
    },
    "expected": {
      "category": "success"
    },
    "provenance": "frozen_v6",
    "description": "A physical line whose byte length is exactly MAX_JSONL_LINE_BYTES (1048576) is accepted. The line is constructed via the padded_object_line recipe: prefix {\"a\":\" + N repetitions of the character x + suffix \"} + a trailing LF, with N chosen so the encoded byte length is exactly total_bytes. expected has no value key here (only category is checked): the padded content itself is not worth freezing verbatim, but the differential test still requires the new primitive and the frozen oracle to independently agree with each other on the actual decoded value."
  },
