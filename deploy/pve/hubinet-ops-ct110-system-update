#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

[[ ${EUID} -eq 0 || ${HUBINET_OPS_TEST_MODE:-0} == 1 ]] || {
  echo "CT110 system update requires root" >&2
  exit 1
}
[[ $# -eq 4 && $1 == --job-id && $3 == --fingerprint ]] || {
  echo "CT110 system update requires a typed job ID and approved fingerprint" >&2
  exit 2
}

JOB_ID="$2"
FINGERPRINT="$4"
[[ "$JOB_ID" =~ ^[a-f0-9]{8,64}$ ]] || { echo "Invalid host job ID" >&2; exit 2; }
[[ "$FINGERPRINT" =~ ^[a-f0-9]{64}$ ]] || { echo "Invalid plan fingerprint" >&2; exit 2; }

RESULT_DIR="${HUBINET_OPS_SELF_UPDATE_RESULTS:-/var/lib/hubinet-ops-hostd/self-update-results}"
JOB_DATABASE="${HUBINET_OPS_HOSTD_DATABASE:-/var/lib/hubinet-ops-hostd/jobs.db}"
HELPER="${HUBINET_OPS_CT110_SYSTEM_HELPER:-/usr/local/lib/hubinet-ops/hubinet_ops_ct110_system.py}"
SYSTEMD_RUN="${HUBINET_OPS_SYSTEMD_RUN:-/usr/bin/systemd-run}"
PYTHON="${HUBINET_OPS_PYTHON:-/usr/bin/python3}"

[[ -f "$HELPER" && ! -L "$HELPER" ]] || {
  echo "CT110 system update helper is not installed" >&2
  exit 1
}

"$PYTHON" "$HELPER" prepare \
  --result-dir "$RESULT_DIR" \
  --job-database "$JOB_DATABASE" \
  --job-id "$JOB_ID" \
  --fingerprint "$FINGERPRINT"

ROLLBACK_ARGS=()
if [[ -r /etc/hubinet-ops/ct110-system-automatic-rollback-vmids ]]; then
  while IFS= read -r vmid; do
    if [[ "$vmid" == 110 ]]; then
      ROLLBACK_ARGS=(--automatic-rollback)
    fi
  done < /etc/hubinet-ops/ct110-system-automatic-rollback-vmids
fi

"$SYSTEMD_RUN" \
  --unit "hubinet-ops-ct110-system-$JOB_ID" \
  --collect \
  --no-block \
  --property Type=exec \
  "$PYTHON" "$HELPER" run \
    --result-dir "$RESULT_DIR" \
    --job-database "$JOB_DATABASE" \
    --job-id "$JOB_ID" \
    --fingerprint "$FINGERPRINT" \
    "${ROLLBACK_ARGS[@]}"

echo "CT110 system update supervisor started for job $JOB_ID"
