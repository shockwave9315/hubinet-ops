#!/usr/bin/env bash
set -Eeuo pipefail

OBSERVATION_ALLOWLIST="/etc/hubinet-ops/observation-vmids"
MANAGED_ALLOWLIST="/etc/hubinet-ops/managed-vmids"
MAINTENANCE_ALLOWLIST="/etc/hubinet-ops/maintenance-vmids"
LIFECYCLE_ALLOWLIST="/etc/hubinet-ops/lifecycle-vmids"
RESOURCE_TYPES="/etc/hubinet-ops/resource-types"
PVE_LOCAL_PATH="/etc/pve/local"
PVE_NODES_PATH="/etc/pve/nodes"
ORIGINAL="${SSH_ORIGINAL_COMMAND:-}"

json_error() {
  local message="$1"
  python3 - "$message" <<'PY'
import json, sys
print(json.dumps({"ok": False, "error": sys.argv[1]}, ensure_ascii=False))
PY
}

fail() {
  json_error "$1"
  exit 1
}

listed() {
  local value="$1" file="$2"
  [[ -f "$file" ]] && grep -Fxq "$value" "$file"
}

if [[ -z "$ORIGINAL" ]]; then
  ORIGINAL="$*"
fi

read -r action vmid argument extra <<<"$ORIGINAL"
[[ -z "${extra:-}" ]] || fail "Too many arguments"
[[ "$action" =~ ^(status|inspect|scan|preflight|snapshot|update|healthcheck|repair|rollback|delete-snapshot|verify|start|shutdown|reboot)$ ]] || fail "Action not allowed"
[[ "$vmid" =~ ^[1-9][0-9]{1,5}$ ]] || fail "Invalid VMID"
listed "$vmid" "$OBSERVATION_ALLOWLIST" || fail "VMID not observation allowed"
[[ -f "$RESOURCE_TYPES" ]] || fail "Missing resource type map"

map_count="$(awk -v id="$vmid" '$1 == id {count++} END {print count+0}' "$RESOURCE_TYPES")"
[[ "$map_count" == "1" ]] || fail "VMID must have exactly one resource type"
resource_type="$(awk -v id="$vmid" '$1 == id {print $2}' "$RESOURCE_TYPES")"
[[ "$resource_type" =~ ^(lxc|qemu)$ ]] || fail "Invalid resource type"

if [[ -n "${argument:-}" ]]; then
  [[ "$argument" =~ ^[A-Za-z0-9_-]+$ ]] || fail "Unsafe argument"
fi
case "$action" in
  snapshot|rollback|delete-snapshot)
    [[ -n "${argument:-}" ]] || fail "Snapshot name required"
    ;;
  *)
    [[ -z "${argument:-}" ]] || fail "Action does not accept an argument"
    ;;
esac

case "$action" in
  start|shutdown|reboot)
    [[ "$resource_type" == "lxc" ]] || fail "Lifecycle is supported only for LXC"
    listed "$vmid" "$LIFECYCLE_ALLOWLIST" || fail "VMID not lifecycle allowed"
    ;;
  inspect)
    if [[ "$resource_type" == "lxc" ]]; then
      listed "$vmid" "$MANAGED_ALLOWLIST" || fail "VMID not managed-executor allowed"
    fi
    ;;
  scan|preflight|healthcheck|verify)
    [[ "$resource_type" == "lxc" ]] || fail "Managed action is supported only for LXC"
    listed "$vmid" "$MANAGED_ALLOWLIST" || fail "VMID not managed-executor allowed"
    ;;
  snapshot|update|repair|rollback|delete-snapshot)
    [[ "$resource_type" == "lxc" ]] || fail "Managed action is supported only for LXC"
    listed "$vmid" "$MANAGED_ALLOWLIST" || fail "VMID not managed-executor allowed"
    listed "$vmid" "$MAINTENANCE_ALLOWLIST" || fail "VMID not maintenance allowed"
    ;;
esac

logger -t hubinet-ops-host "action=$action vmid=$vmid resource_type=$resource_type"

status_lxc() {
  local raw state
  if ! raw="$(timeout --signal=TERM --kill-after=5s 30s pct status "$vmid" 2>&1)"; then
    fail "pct status failed or timed out: $raw"
  fi
  state="$(awk '{print $2}' <<<"$raw")"
  printf '%s' "$state"
}

status_qemu() {
  local raw state
  if ! raw="$(timeout --signal=TERM --kill-after=5s 30s qm status "$vmid" 2>&1)"; then
    fail "qm status failed or timed out: $raw"
  fi
  state="$(awk '{print $2}' <<<"$raw")"
  printf '%s' "$state"
}

resolve_local_pve_node() {
  local resolved nodes_root node
  [[ -e "$PVE_LOCAL_PATH" ]] || return 1
  resolved="$(readlink -f -- "$PVE_LOCAL_PATH" 2>/dev/null)" || return 1
  nodes_root="$(readlink -f -- "$PVE_NODES_PATH" 2>/dev/null)" || return 1
  [[ -d "$resolved" && -d "$nodes_root" ]] || return 1
  node="$(basename -- "$resolved")" || return 1
  [[ "$node" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
  [[ "$resolved" == "$nodes_root/$node" ]] || return 1
  printf '%s' "$node"
}

case "$action" in
  status)
    if [[ "$resource_type" == "lxc" ]]; then
      state="$(status_lxc)"
      printf '{"ok":true,"data":{"runtime_status":"%s","lxc_status":"%s"}}\n' "$state" "$state"
    else
      state="$(status_qemu)"
      printf '{"ok":true,"data":{"runtime_status":"%s","qemu_status":"%s"}}\n' "$state" "$state"
    fi
    ;;
  inspect)
    if [[ "$resource_type" == "lxc" ]]; then
      state="$(status_lxc)"
      if [[ "$state" != "running" ]]; then
        printf '{"ok":true,"data":{"runtime_status":"%s","lxc_status":"%s","health_status":"offline","health_score":0}}\n' "$state" "$state"
        exit 0
      fi
      timeout --signal=TERM --kill-after=10s 180s \
        pct exec "$vmid" -- /usr/local/sbin/hubinet-maint inspect
      exit 0
    fi

    state="$(status_qemu)"
    if ! pve_node="$(resolve_local_pve_node)"; then
      fail "Local PVE node could not be resolved from /etc/pve/local"
    fi
    if ! current="$(timeout --signal=TERM --kill-after=5s 30s \
      pvesh get "/nodes/$pve_node/qemu/$vmid/status/current" --output-format json 2>&1)"; then
      fail "QEMU current status failed or timed out: $current"
    fi
    guest_status="unknown"
    guest='[]'
    if [[ "$state" == "running" ]]; then
      if guest="$(timeout --signal=TERM --kill-after=5s 30s \
        qm guest cmd "$vmid" network-get-interfaces 2>/dev/null)"; then
        guest_status="available"
      else
        guest_status="unavailable"
        guest='[]'
      fi
    fi
    python3 - "$state" "$guest_status" "$current" "$guest" <<'PY'
import json, sys

state, guest_status, current_raw, guest_raw = sys.argv[1:]
try:
    current = json.loads(current_raw)
except (TypeError, ValueError):
    current = {}
try:
    guest = json.loads(guest_raw)
except (TypeError, ValueError):
    guest = []
if isinstance(guest, dict):
    guest = guest.get("result", guest.get("data", []))
addresses = []
for interface in guest if isinstance(guest, list) else []:
    for address in interface.get("ip-addresses", []) if isinstance(interface, dict) else []:
        value = address.get("ip-address") if isinstance(address, dict) else None
        if value and value not in {"127.0.0.1", "::1"}:
            addresses.append(str(value)[:128])
data = {
    "runtime_status": state,
    "qemu_status": state,
    "health_status": "healthy" if state == "running" else "offline",
    "health_score": 100 if state == "running" else 0,
    "name": str(current.get("name", ""))[:255],
    "uptime_seconds": max(0, int(current.get("uptime", 0) or 0)),
    "cpu": {"usage": current.get("cpu"), "cores": current.get("cpus")},
    "memory": {"used_bytes": current.get("mem"), "total_bytes": current.get("maxmem")},
    "disk": {"used_bytes": current.get("disk"), "total_bytes": current.get("maxdisk")},
    "network": {"in_bytes": current.get("netin"), "out_bytes": current.get("netout")},
    "guest_agent_status": guest_status,
    "ip_addresses": addresses[:32],
}
print(json.dumps({"ok": True, "data": data}, ensure_ascii=False, separators=(",", ":")))
PY
    ;;
  scan)
    timeout --signal=TERM --kill-after=15s 650s pct exec "$vmid" -- /usr/local/sbin/hubinet-maint check-updates
    ;;
  preflight)
    timeout --signal=TERM --kill-after=15s 650s pct exec "$vmid" -- /usr/local/sbin/hubinet-maint preflight
    ;;
  update)
    timeout --signal=TERM --kill-after=30s 4400s pct exec "$vmid" -- /usr/local/sbin/hubinet-maint update
    ;;
  healthcheck)
    timeout --signal=TERM --kill-after=10s 180s pct exec "$vmid" -- /usr/local/sbin/hubinet-maint healthcheck
    ;;
  repair)
    timeout --signal=TERM --kill-after=30s 850s pct exec "$vmid" -- /usr/local/sbin/hubinet-maint repair
    ;;
  verify)
    timeout --signal=TERM --kill-after=15s 650s pct exec "$vmid" -- /usr/local/sbin/hubinet-maint verify
    ;;
  start)
    if ! raw="$(timeout --signal=TERM --kill-after=10s 120s pct start "$vmid" 2>&1)"; then
      fail "graceful start failed or timed out: $raw"
    fi
    printf '{"ok":true,"data":{"action":"start"}}\n'
    ;;
  shutdown)
    if ! raw="$(timeout --signal=TERM --kill-after=10s 120s pct shutdown "$vmid" 2>&1)"; then
      fail "graceful shutdown failed or timed out: $raw"
    fi
    printf '{"ok":true,"data":{"action":"shutdown"}}\n'
    ;;
  reboot)
    if ! raw="$(timeout --signal=TERM --kill-after=10s 120s pct reboot "$vmid" 2>&1)"; then
      fail "graceful reboot failed or timed out: $raw"
    fi
    printf '{"ok":true,"data":{"action":"reboot"}}\n'
    ;;
  snapshot)
    if ! raw="$(timeout --signal=TERM --kill-after=30s 550s \
      pct snapshot "$vmid" "$argument" --description "Hubinet Ops pre-update snapshot" 2>&1)"; then
      fail "snapshot failed or timed out: $raw"
    fi
    printf '{"ok":true,"data":{"snapshot":"%s"}}\n' "$argument"
    ;;
  rollback)
    timeout --signal=TERM --kill-after=15s 120s pct stop "$vmid" --timeout 90 >/dev/null 2>&1 || true
    if ! raw="$(timeout --signal=TERM --kill-after=30s 900s pct rollback "$vmid" "$argument" 2>&1)"; then
      fail "rollback failed or timed out: $raw"
    fi
    if ! raw="$(timeout --signal=TERM --kill-after=15s 120s pct start "$vmid" 2>&1)"; then
      fail "container start after rollback failed or timed out: $raw"
    fi
    printf '{"ok":true,"data":{"rolled_back_to":"%s"}}\n' "$argument"
    ;;
  delete-snapshot)
    if ! raw="$(timeout --signal=TERM --kill-after=15s 300s pct delsnapshot "$vmid" "$argument" 2>&1)"; then
      fail "snapshot deletion failed or timed out: $raw"
    fi
    printf '{"ok":true,"data":{"deleted_snapshot":"%s"}}\n' "$argument"
    ;;
esac
