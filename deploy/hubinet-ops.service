[Unit]
Description=Hubinet Ops Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hubinetops
Group=hubinetops
EnvironmentFile=/etc/hubinet-ops/agent.env
WorkingDirectory=/opt/hubinet-ops
ExecStart=/opt/hubinet-ops/.venv/bin/uvicorn app.main_v023:app --host 0.0.0.0 --port 8787 --proxy-headers
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/hubinet-ops
ReadOnlyPaths=/etc/hubinet-ops /opt/hubinet-ops
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
